# SpaceLab Backend Configuration
# 复制此文件为 .env 并修改配置

# Server
SERVER_PORT=8080
ENVIRONMENT=development

# Database
DATABASE_URL=postgres://spacelab:spacelab_password@localhost:5432/spacelab?sslmode=disable

# Redis (optional, set empty to disable)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=
JWT_EXPIRATION=24h
# 刷新令牌有效期（独立于访问令牌的长时效令牌，用于无感续期）
# 用户登录态靠 refresh token 维持，建议设置为 7 天（168h）或更久。
# 访问令牌过期后由前端用 refresh token 自动换取新令牌，避免频繁重新登录。
# 注：修改密码/重置密码会使旧 refresh token 立即失效（基于 security stamp）。
JWT_REFRESH_EXPIRATION=168h

# CORS
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080

# File Upload
MAX_UPLOAD_SIZE=10485760
UPLOAD_PATH=./uploads

# Cloudflare Turnstile (需在 https://dash.cloudflare.com 申请)
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# Resend Transactional Email (optional)
RESEND_API_KEY=
RESEND_FROM=noreply@tx.yourdomain.com

# MailerLite Newsletter (optional)
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=
MAILERLITE_BASE_URL=https://api.mailerlite.com/api/v2

# LiveComment (optional)
LIVECOMMENT_SITE_ID=

# OAuth 登录（Google / GitHub）
# 回调地址格式：{OAUTH_CALLBACK_BASE_URL}/api/v1/auth/{provider}/callback
# 本地开发请将 OAUTH_CALLBACK_BASE_URL 设为 http://localhost:4200（前端地址，经 proxy 转发到后端）
# 生产环境设为你的站点域名，如 https://yourdomain.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_CALLBACK_BASE_URL=http://localhost:4200
